{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/app/*"],
      "@repo/shared/*": ["../shared/src/*"],
      "@repo/jsonplaceholder/*": ["../modules/jsonplaceholder/src/*"],
      "@repo/pokemon/*": ["../modules/pokemon/src/*"],
      "@repo/rick-and-morty/*": ["../modules/rick-and-morty/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
