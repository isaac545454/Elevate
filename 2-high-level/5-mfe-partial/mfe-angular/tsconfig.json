{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "include": ["src"]
}
