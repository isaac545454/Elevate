{
  "name": "next-monolito",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "CONSOLE_NINJA_DISABLE=1 DISABLE_CONSOLE_NINJA=1 next dev --port 3010",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "playwright install chromium",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "CONSOLE_NINJA_DISABLE=1 DISABLE_CONSOLE_NINJA=1 playwright test",
    "test:e2e:local": "CONSOLE_NINJA_DISABLE=1 DISABLE_CONSOLE_NINJA=1 env -u CI playwright test",
    "test:e2e:headed": "CONSOLE_NINJA_DISABLE=1 DISABLE_CONSOLE_NINJA=1 playwright test --headed",
    "test:e2e:ci": "CONSOLE_NINJA_DISABLE=1 DISABLE_CONSOLE_NINJA=1 CI=true playwright test",
    "test:e2e:ui": "CONSOLE_NINJA_DISABLE=1 DISABLE_CONSOLE_NINJA=1 playwright test --ui"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.9",
    "axios": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.100.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
